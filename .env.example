# Frontend-only Supabase configuration.
# Only publishable values belong here — never SERVICE_ROLE, DB passwords or JWT secrets.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-ANON-KEY

# ── Google Calendar / Meet (server-side, NOT frontend) ───────────────────────
# These are Edge Function secrets, set with `supabase secrets set ...` — never
# in this file or any VITE_ variable. The OAuth redirect URI to register in the
# Google Cloud Console is:
#   https://YOUR-PROJECT-REF.supabase.co/functions/v1/google/callback
#   supabase secrets set GOOGLE_CLIENT_ID=...
#   supabase secrets set GOOGLE_CLIENT_SECRET=...
#   supabase secrets set GOOGLE_STATE_SECRET=<any-long-random-string>
#   supabase secrets set FRONTEND_URL=https://your-app-domain
